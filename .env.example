# Encryption key for storing API keys (32 bytes, base64 encoded)
ENCRYPTION_KEY="your-32-byte-encryption-key-base64"

# Optional: Default PhantomBuster settings (users can override in UI)
# PHANTOMBUSTER_API_KEY=
# PHANTOMBUSTER_AGENT_ID=
