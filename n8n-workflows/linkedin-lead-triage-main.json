    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Create leads from post authors if they match ICP criteria\nINSERT INTO leads (name, profile_url, headline, company, source_post_id, status)\nSELECT DISTINCT ON (p.author_profile_url)\n  p.author_name,\n  p.author_profile_url,\n  p.author_headline,\n  p.author_company,\n  p.id,\n  'new'\nFROM posts p\nLEFT JOIN leads l ON l.profile_url = p.author_profile_url\nWHERE l.id IS NULL\n  AND p.scraped_at > NOW() - INTERVAL '1 hour'\n  AND p.engagement_score > 10\nRETURNING id, name;"
      },
      "id": "create-leads",
      "name": "Create New Leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [1560, 300],
