    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  os.id as sequence_id,\n  os.lead_id,\n  os.step_number,\n  os.scheduled_for,\n  os.message_template,\n  l.name as lead_name,\n  l.profile_url,\n  l.company,\n  l.status as lead_status\nFROM outreach_sequence os\nJOIN leads l ON l.id = os.lead_id\nWHERE os.status = 'pending'\n  AND os.scheduled_for <= NOW()\n  AND l.status NOT IN ('replied', 'opted_out', 'converted')\nORDER BY os.scheduled_for ASC\nLIMIT 20;"
      },
      "id": "get-due-followups",
      "name": "Get Due Follow-ups",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [460, 740],
