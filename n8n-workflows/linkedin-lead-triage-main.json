    {
      "parameters": {
        "jsCode": "// Personalize message template\nconst item = $input.first().json;\nconst config = $('⚙️ Configuration').item.json;\n\nconst personalized = item.message_template\n  .replace(/\\{\\{name\\}\\}/g, item.lead_name || 'there')\n  .replace(/\\{\\{first_name\\}\\}/g, (item.lead_name || 'there').split(' ')[0])\n  .replace(/\\{\\{company\\}\\}/g, item.company || 'your company');\n\nreturn {\n  json: {\n    ...item,\n    personalized_message: personalized,\n    APP_WEBHOOK_URL: config.APP_WEBHOOK_URL\n  }\n};"
      },
