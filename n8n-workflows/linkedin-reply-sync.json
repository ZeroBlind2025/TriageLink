{
  "name": "LinkedIn Reply Sync",
  "nodes": [
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"PHANTOMBUSTER_OUTREACH_AGENT_ID\": \"YOUR_OUTREACH_AGENT_ID_HERE\",\n  \"APP_WEBHOOK_URL\": \"https://your-app.vercel.app\"\n}",
        "options": {}
      },
      "id": "config",
      "name": "⚙️ Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 140],
      "notesInFlow": true,
      "notes": "👆 EDIT THIS NODE: Set your PhantomBuster Outreach Agent ID and App URL here"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "check-replies",
      "name": "Check Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.phantombuster.com/api/v2/agents/fetch-output?id={{ $('⚙️ Configuration').item.json.PHANTOMBUSTER_OUTREACH_AGENT_ID }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "fetch-outreach-results",
      "name": "Fetch Outreach Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "phantombuster-creds",
          "name": "PhantomBuster API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter for leads that have replied\nconst output = $input.first().json;\nconst config = $('⚙️ Configuration').item.json;\nlet replied = [];\n\ntry {\n  const data = typeof output.output === 'string' ? JSON.parse(output.output) : (output.resultObject || []);\n  \n  if (Array.isArray(data)) {\n    replied = data\n      .filter(item => item.replied === true || item.replied === 'true' || item.status === 'replied')\n      .map(item => ({\n        profile_url: item.profileUrl || item.linkedInProfileUrl,\n        name: item.profileName || item.fullName,\n        replied_at: item.repliedAt || new Date().toISOString(),\n        APP_WEBHOOK_URL: config.APP_WEBHOOK_URL\n      }));\n  }\n} catch (e) {\n  console.log('Parse error:', e.message);\n}\n\nreturn replied.map(r => ({ json: r }));"
      },
      "id": "filter-replied",
      "name": "Filter Replied Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-replies",
              "leftValue": "={{ $json.profile_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-replies",
      "name": "Has Replies?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.APP_WEBHOOK_URL }}/api/webhooks/lead-replied",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ profile_url: $json.profile_url, name: $json.name, replied_at: $json.replied_at }) }}"
      },
      "id": "notify-reply",
      "name": "Mark as Replied in App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 240]
    }
  ],
  "connections": {
    "Check Every 2 Hours": {
      "main": [[{ "node": "⚙️ Configuration", "type": "main", "index": 0 }]]
    },
    "⚙️ Configuration": {
      "main": [[{ "node": "Fetch Outreach Results", "type": "main", "index": 0 }]]
    },
    "Fetch Outreach Results": {
      "main": [[{ "node": "Filter Replied Leads", "type": "main", "index": 0 }]]
    },
    "Filter Replied Leads": {
      "main": [[{ "node": "Has Replies?", "type": "main", "index": 0 }]]
    },
    "Has Replies?": {
      "main": [[{ "node": "Mark as Replied in App", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
